# --- Database (lokal: docker compose up -d db) ---
POSTGRES_PORT=5432
DATABASE_URL=postgresql://suara:suara@localhost:5432/suara_mipa
TEST_DATABASE_URL=postgresql://suara:suara@localhost:5432/suara_mipa_test
DB_POOL_MAX=10

# --- Aplikasi ---
APP_URL=http://localhost:3000
# Generate: openssl rand -base64 48
JWT_SECRET=

# --- Login PAuS (SSO Unpad) ---
# Client ID & secret dari Tim Platform. Redirect URI yang didaftarkan ke PAuS:
#   <APP_URL>/api/auth/paus/callback
PAUS_CLIENT_ID=
PAUS_CLIENT_SECRET=
PAUS_REDIRECT_URI=
# Email/NPM PAuS (pisahkan koma) yang otomatis jadi ADMIN saat login pertama.
ADMIN_IDENTIFIERS=
# Login email + password akun seeder. HANYA untuk development lokal / test.
PASSWORD_LOGIN_ENABLED=true

# --- Storage S3 / MinIO (lokal: docker compose up -d minio minio-init) ---
AWS_ENDPOINT=http://localhost:9000
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=suara-mipa
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_USE_PATH_STYLE_ENDPOINT=true
# Base URL publik objek (termasuk bucket). Kosong = <AWS_ENDPOINT>/<AWS_BUCKET>.
AWS_URL=
STORAGE_ROOT_FOLDER=suara-mipa/local

# Password akun contoh dari seeder (npm run db:seed). Kosong = dibuat acak & dicetak saat seed.
SEED_PASSWORD=
